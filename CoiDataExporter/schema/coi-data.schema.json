{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/coi-data-exporter/schema/coi-data.v1.json",
  "title": "Captain of Industry data export",
  "type": "object",
  "required": ["schema_version", "game_version", "exported_at_utc", "products", "recipes", "buildings"],
  "properties": {
    "schema_version": { "const": 1 },
    "game_version": { "type": "string", "minLength": 1 },
    "exported_at_utc": { "type": "string", "format": "date-time" },
    "products": {
      "type": "array",
      "items": { "$ref": "#/$defs/product" }
    },
    "recipes": {
      "type": "array",
      "items": { "$ref": "#/$defs/recipe" }
    },
    "buildings": {
      "type": "array",
      "items": { "$ref": "#/$defs/building" }
    }
  },
  "$defs": {
    "quantity": {
      "type": "object",
      "required": ["product_id", "product_name", "amount"],
      "properties": {
        "product_id": { "type": "string", "minLength": 1 },
        "product_name": { "type": "string" },
        "amount": { "type": "number", "exclusiveMinimum": 0 }
      },
      "additionalProperties": false
    },
    "product": {
      "type": "object",
      "required": ["id", "name", "is_storable", "is_trash", "radioactivity"],
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "name": { "type": "string" },
        "state": { "type": ["string", "null"] },
        "is_storable": { "type": "boolean" },
        "is_trash": { "type": "boolean" },
        "radioactivity": { "type": "number" }
      },
      "additionalProperties": false
    },
    "recipe": {
      "type": "object",
      "required": ["id", "name", "duration_seconds", "inputs", "outputs"],
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "name": { "type": "string" },
        "duration_seconds": { "type": "number", "exclusiveMinimum": 0 },
        "inputs": { "type": "array", "items": { "$ref": "#/$defs/quantity" } },
        "outputs": { "type": "array", "items": { "$ref": "#/$defs/quantity" } }
      },
      "additionalProperties": false
    },
    "building": {
      "type": "object",
      "required": ["id", "name", "is_farm", "is_storage", "is_mine", "workers", "maintenance_per_month", "electricity_consumed", "electricity_generated", "storage_capacity", "transfer_speed_per_minute", "research_speed", "build_costs", "recipe_ids"],
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "name": { "type": "string" },
        "category_id": { "type": ["string", "null"] },
        "category_name": { "type": ["string", "null"] },
        "is_farm": { "type": "boolean" },
        "is_storage": { "type": "boolean" },
        "is_mine": { "type": "boolean" },
        "workers": { "type": "integer", "minimum": 0 },
        "maintenance_product_id": { "type": ["string", "null"] },
        "maintenance_per_month": { "type": "number", "minimum": 0 },
        "electricity_consumed": { "type": "number", "minimum": 0 },
        "electricity_generated": { "type": "number", "minimum": 0 },
        "storage_capacity": { "type": "number", "minimum": 0 },
        "transfer_speed_per_minute": { "type": "number", "minimum": 0 },
        "research_speed": { "type": "number", "minimum": 0 },
        "build_costs": { "type": "array", "items": { "$ref": "#/$defs/quantity" } },
        "recipe_ids": { "type": "array", "items": { "type": "string", "minLength": 1 } }
      },
      "additionalProperties": false
    }
  }
}
