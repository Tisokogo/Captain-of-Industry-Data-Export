{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Captain of Industry mod manifest",
  "type": "object",
  "required": ["id", "version", "primary_dlls"],
  "properties": {
    "id": {
      "type": "string",
      "pattern": "^[a-zA-Z0-9][a-zA-Z0-9_-]*$"
    },
    "version": {
      "type": "string",
      "pattern": "^[0-9]+\\.[0-9]+(\\.[0-9]+[a-z]?)?$"
    },
    "display_name": { "type": "string", "maxLength": 50 },
    "description_short": { "type": "string", "maxLength": 180 },
    "description_long": { "type": "string" },
    "authors": {
      "oneOf": [
        { "type": "string" },
        { "type": "array", "items": { "type": "string" } }
      ]
    },
    "primary_dlls": {
      "type": "array",
      "items": { "type": "string" },
      "minItems": 1
    },
    "non_locking_dll_load": { "type": "boolean" },
    "can_add_to_saved_game": { "type": "boolean" },
    "can_remove_from_saved_game": { "type": "boolean" }
  },
  "additionalProperties": true
}
